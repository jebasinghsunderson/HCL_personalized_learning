# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/learning_path_db"

# Authentication
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# AI Provider Configuration
# ===========================================
# Set AI_PROVIDER to one of: anthropic, grok, groq, openai, custom, fallback
AI_PROVIDER="fallback"

# Optional: Override the model name for any provider
# AI_MODEL="grok-3-mini"

# --- Anthropic (paid) ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Grok / xAI (free tier available) ---
# XAI_API_KEY="xai-..."

# --- Groq (free tier, very fast) ---
# GROQ_API_KEY="gsk_..."

# --- OpenAI (paid) ---
# OPENAI_API_KEY="sk-..."

# --- Custom OpenAI-compatible endpoint ---
# CUSTOM_AI_API_KEY="your-key"
# CUSTOM_AI_BASE_URL="https://your-endpoint.com/v1"
