generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       LearnerProfile?
  conversations Conversation[]

  @@map("users")
}

model LearnerProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  experienceLevel        String   @default("beginner")
  weeklyHours            Int      @default(5)
  preferredLearningStyle String   @default("mixed")
  preferredDifficulty    String   @default("intermediate")
  currentRole            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests     Interest[]
  learnerSkills LearnerSkill[]
  goals         Goal[]
  learningPaths LearningPath[]
  progress      Progress[]
  feedback      Feedback[]
  attempts      AssessmentAttempt[]

  @@map("learner_profiles")
}

model Interest {
  id        String @id @default(cuid())
  profileId String
  name      String

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("interests")
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String

  learnerSkills  LearnerSkill[]
  resourceSkills ResourceSkill[]
  prerequisites  Prerequisite[]    @relation("skill")
  prerequisiteOf Prerequisite[]    @relation("prerequisite")
  assessments    Assessment[]
  pathItems      LearningPathItem[]

  @@map("skills")
}

model LearnerSkill {
  id              String @id @default(cuid())
  profileId       String
  skillId         String
  proficiency     Int    @default(0) // 0-5 scale
  yearsExperience Float  @default(0)

  profile LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("learner_skills")
}

model Goal {
  id              String   @id @default(cuid())
  profileId       String
  title           String
  description     String?
  targetRole      String?
  timeframeMonths Int      @default(6)
  status          String   @default("active")
  requiredSkills  String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile      LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  learningPath LearningPath[]

  @@map("goals")
}

model Resource {
  id             String  @id @default(cuid())
  title          String
  description    String?
  type           String  // course, tutorial, project, book, video, article
  provider       String?
  url            String?
  difficulty     String  @default("intermediate") // beginner, intermediate, advanced
  estimatedHours Float   @default(1)
  rating         Float   @default(4.0)

  skills    ResourceSkill[]
  pathItems LearningPathItem[]
  progress  Progress[]
  feedback  Feedback[]

  @@map("resources")
}

model ResourceSkill {
  id         String @id @default(cuid())
  resourceId String
  skillId    String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@map("resource_skills")
}

model Prerequisite {
  id             String @id @default(cuid())
  skillId        String
  prerequisiteId String

  skill        Skill @relation("skill", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite Skill @relation("prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([skillId, prerequisiteId])
  @@map("prerequisites")
}

model LearningPath {
  id          String   @id @default(cuid())
  profileId   String
  goalId      String?
  title       String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile LearnerProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  goal    Goal?              @relation(fields: [goalId], references: [id])
  items   LearningPathItem[]

  @@map("learning_paths")
}

model LearningPathItem {
  id             String  @id @default(cuid())
  learningPathId String
  resourceId     String?
  skillId        String?
  order          Int
  phase          String  @default("foundations")
  status         String  @default("locked") // locked, not_started, in_progress, completed, skipped
  estimatedHours Float   @default(1)
  isMilestone    Boolean @default(false)
  title          String?
  description    String?

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id])
  skill        Skill?       @relation(fields: [skillId], references: [id])

  @@map("learning_path_items")
}

model Assessment {
  id          String @id @default(cuid())
  title       String
  description String?
  skillId     String
  difficulty  String @default("intermediate")

  skill     Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model Question {
  id           String   @id @default(cuid())
  assessmentId String
  text         String
  options      String[]
  correctIndex Int
  explanation  String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  profileId    String
  assessmentId String
  score        Float
  passed       Boolean
  answers      Int[]
  completedAt  DateTime  @default(now())

  profile    LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_attempts")
}

model Progress {
  id          String   @id @default(cuid())
  profileId   String
  resourceId  String
  status      String   @default("not_started") // not_started, in_progress, completed
  completedAt DateTime?
  timeSpent   Float    @default(0) // hours
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile  LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resource Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([profileId, resourceId])
  @@map("progress")
}

model Feedback {
  id         String   @id @default(cuid())
  profileId  String
  resourceId String
  type       String   // helpful, not_helpful, too_easy, too_difficult, already_know, not_relevant, more_practical
  comment    String?
  createdAt  DateTime @default(now())

  profile  LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resource Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user, assistant
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}
